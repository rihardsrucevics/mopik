# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real values stay local; .env.example (no values) is committed
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw Overpass dumps cached by scripts/build_poi_dataset.py
.poi-cache/

# agent worktrees
.claude/worktrees/
.env*.local

# TET source GPX: 117 MB, re-downloadable from transeurotrail.org, and the
# built output in public/tet* is what the app actually reads.
/data/tet-gpx/

# Riders' own ridden-roads GPX, the same rule: the rider's files stay with the
# rider, and public/ridden* (26 KB, committed) is what the app reads.
/data/ridden-gpx/

# POI build outputs from scripts/build_poi_dataset.py (Geofabrik path): per
# country files and the build log. What the app reads is the file the loader
# points at; these are intermediates until the loader switch decides storage.
/data/poi-*.geojson
/data/poi-index.json
/data/poi-build.log
/.venv/

# python bytecode from the build scripts
__pycache__/
