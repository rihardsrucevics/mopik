# Optional — BRouter routing. Defaults to the public https://brouter.de
# instance, which throttles bursts (403 "retry later" after ~6 quick
# requests). Point this at a self-hosted BRouter to lift that limit.
# BROUTER_BASE_URL=http://localhost:17777

# Required — isochrones (BRouter has none) and geocoding.
# Free key (200k credits/month) at https://client.stadiamaps.com
# Note: the free tier is development/evaluation/non-commercial only.
STADIA_API_KEY=

# Optional — point at a self-hosted Valhalla instead of Stadia's hosted one.
# Valhalla is Apache 2.0, so this is the route to commercial use.
# VALHALLA_BASE_URL=http://localhost:8002

# Still used only by lib/geo/geocode.ts until geocoding moves to Stadia.
GRAPHHOPPER_API_KEY=

# Claude — parses free-text prompts and drives the ride chat (/api/route-chat).
# Without it the regex heuristic parses prompts and the chat is unavailable.
ANTHROPIC_API_KEY=
# Required with an identity-linked key (Console → Settings → Workspaces, "wrkspc_…").
ANTHROPIC_WORKSPACE_ID=
# ANTHROPIC_MODEL=claude-opus-5
